// modlist.json5 – updated by StarDöring on 2026-08-29
// JSON5: comments and trailing commas are fine. "id" is the SMAPI UniqueID and the only required field.
// Optional per mod: name, nexus: <id>, github: "owner/repo", githubAsset: "<zip name part>", url, version ("latest" or a minimum),
// optional: true (not needed on every device), enabled: false (installed but switched off), note.
{
  name: "StarDoeringMods",
  smapi: "latest",
  mods: [
    {
      id: "Pathoschild.Automate",
      name: "Automate",
      nexus: 1063,
      url: "https://www.nexusmods.com/stardewvalley/mods/1063",
      note: "2.6.1 (2026-03). Pathoschild publishes on Nexus/ModDrop/CurseForge only; the GitHub repo has no release assets.",
      enabled: false,
    },
    {
      id: "haze1nuts.evenbetterartisangoodicons",
      name: "Even Better Artisan Good Icons",
      github: "chsiao58/EvenBetterArtisanGoodIcons",
      githubAsset: "EvenBetterArtisanGoodIcons",
      url: "https://github.com/chsiao58/EvenBetterArtisanGoodIcons/releases",
      note: "1.6.6 (2024-05), GitHub-only – there is no Nexus page, so no 'nexus' field. Successor of Cat's 'Better Artisan Good Icons' (Nexus 2080), which smapi.io marks as superseded. Works on vanilla goods without content packs.",
      enabled: true,
    },
    {
      id: "Pathoschild.ContentPatcher",
      name: "Content Patcher",
      nexus: 1915,
      url: "https://www.nexusmods.com/stardewvalley/mods/1915",
      note: "Framework for content packs (2.9.1). Nothing in this list needs it yet, but almost every visual/content mod does.",
      enabled: true,
    },
    {
      id: "spacechase0.GenericModConfigMenu",
      name: "Generic Mod Config Menu",
      nexus: 5098,
      url: "https://www.nexusmods.com/stardewvalley/mods/5098",
      optional: true,
      note: "Optional dependency of Automate, Lookup Anything, NPC Map Locations, Better Sprinklers Plus, Auto Animal Doors and others – adds an in-game settings UI for them. Nothing hard-requires it.",
      enabled: true,
    },
    {
      id: "Armitxes.UnlimitedPlayers",
      name: "Unlimited Players",
      nexus: 2213,
      url: "https://www.nexusmods.com/stardewvalley/mods/2213",
      note: "2024.4.16 – the only 'Unlimited Players' mod; smapi.io lists it as Ok for 1.6. Only the host needs it, but harmless on clients. GitHub releases (Armitxes/StardewValley_UnlimitedPlayers) contain no zip, so Nexus is the download source.",
      enabled: true,
    },
  ],
}
